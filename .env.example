# Credentials for the official Clash of Clans API.
# Create them at https://developer.clashofclans.com  (free, one key per IP address).
# Copy this file to `.env` and fill it in. `.env` is gitignored - never commit it.

# The email and password of your developer account (NOT your Supercell ID).
COC_EMAIL="you@example.com"
COC_PASSWORD="your-api-password"

# Your clan tag. Both forms work: "#2PP0JCCCV" or the URL-encoded "%232PP0JCCCV".
CLAN_TAG="%232PP0JCCCV"

# Optional defaults (CLI flags override these)
# CWL_LANG="en"
# CWL_BONUSES="7"
